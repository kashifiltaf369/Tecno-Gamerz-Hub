// Prisma schema for Tecno Gamerz Hub
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - core user information
model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         RoleName   @default(GAMER)
  username     String?    @unique
  image        String?
  status       UserStatus @default(ACTIVE)
  totalPoints  Int        @default(0)
  xp           Int        @default(0)
  level        Int        @default(1)
  badges       Json       @default("[]")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  accounts  Account[]
  sessions  Session[]
  userRoles UserRole[]
  auditLogs AuditLog[]

  // Gaming-specific relations (for future expansion)
  createdTournaments Tournament[] @relation("TournamentCreator")
  tournamentParticipants TournamentParticipant[]
  matchResults MatchResult[]
  
  // Social features relations
  sentFriendships       Friendship[] @relation("FriendshipRequester")
  receivedFriendships   Friendship[] @relation("FriendshipReceiver")
  sentMessages          ChatMessage[] @relation("MessageSender")
  receivedMessages      ChatMessage[] @relation("MessageReceiver")
  notifications         Notification[]
  
  // Content relations
  userContent           UserContent[] @relation("UserContent")
  
  // Video system relations
  videoInteractions     VideoInteraction[]
  videoQuizAttempts     VideoQuizAttempt[]
  videoClips            VideoClip[]
  videoClipLikes        VideoClipLike[]
  
  // Payment system relations
  payments              Payment[]
  subscriptions         Subscription[]
  
  // Merchant store relations
  orders                Order[]     @relation("UserOrders")
  purchases             Purchase[]  @relation("UserPurchases")
  
  // videos Video[]
  // donations Donation[]
  // comments Comment[]

  @@map("users")
}

// OAuth account information
model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  type              String?
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Session model for NextAuth.js (optional - can use JWT only)
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Role-based access control
model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

// Many-to-many relationship between users and roles
model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// Permission model
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g., "user:read", "tournament:create"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

// Many-to-many relationship between roles and permissions
model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// Audit log for tracking user actions
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g., "user.created", "tournament.joined"
  resource   String   // e.g., "User", "Tournament"
  resourceId String?  // ID of the affected resource
  metadata   Json?    // Additional context data
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// Enums
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum RoleName {
  ADMIN
  GAMER
  FAN

  @@map("role_name")
}

// Tournament system
model Tournament {
  id                    String   @id @default(uuid())
  title                 String
  description           String
  game                  String
  streamUrl             String?  // Twitch/YouTube stream URL
  entryFee              Decimal? @db.Money // Entry fee for paid tournaments
  currency              String   @default("USD") @db.VarChar(3)
  maxParticipants       Int?     // Maximum number of participants
  prizePool             Decimal? @db.Money // Total prize pool
  startDate             DateTime
  endDate               DateTime
  createdById           String
  isTecnoGamerzOfficial Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  createdBy    User                     @relation("TournamentCreator", fields: [createdById], references: [id])
  participants TournamentParticipant[]
  matchResults MatchResult[]

  @@map("tournaments")
}

model TournamentParticipant {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  paymentId    String?  // Reference to payment for paid tournaments
  isPaid       Boolean  @default(false) // Whether participant has paid entry fee
  joinedAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([paymentId])
  @@map("tournament_participants")
}

// Match result and scoring system
model MatchResult {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  score        Int
  awardedPoints Int     // Final points awarded (with multiplier applied)
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tournamentId])
  @@index([createdAt])
  @@map("match_results")
}

// User Content for sharing highlights and clips
model UserContent {
  id        String   @id @default(uuid())
  userId    String
  title     String
  videoUrl  String
  createdAt DateTime @default(now())

  user User @relation("UserContent", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("user_content")
}

// Merchant Store System Models

// Product model for digital and physical items
model Product {
  id          String      @id @default(uuid())
  title       String
  description String?
  price       Int         // Price in cents (like Stripe)
  currency    String      @default("USD") @db.VarChar(3)
  stock       Int?        // null = digital/unlimited inventory
  images      Json?       // Array of image URLs
  type        ProductType
  metadata    Json?       // Additional product data (badgeId, css, etc.)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  orderItems  OrderItem[]
  purchases   Purchase[]  @relation("ProductPurchases")

  @@index([type])
  @@index([isActive])
  @@index([createdAt])
  @@map("products")
}

// Order model for tracking purchases
model Order {
  id                String      @id @default(uuid())
  userId            String?     // nullable for guest orders
  totalAmount       Int         // Total amount in cents
  currency          String      @default("USD") @db.VarChar(3)
  status            OrderStatus @default(PENDING)
  externalPaymentId String?     // Stripe payment intent ID
  metadata          Json?       // Additional order data
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  user  User?       @relation("UserOrders", fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([externalPaymentId])
  @@map("orders")
}

// Order items for individual products in an order
model OrderItem {
  id              String @id @default(uuid())
  orderId         String
  productId       String
  priceAtPurchase Int    // Price when purchased (historical)
  quantity        Int
  metadata        Json?  // Item-specific metadata

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Purchase model for tracking digital goods ownership
model Purchase {
  id        String   @id @default(uuid())
  userId    String
  productId String
  orderId   String?  // Reference to the order that created this purchase
  grantedAt DateTime @default(now())
  metadata  Json?    // Purchase-specific data

  // Relations
  user    User    @relation("UserPurchases", fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation("ProductPurchases", fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("purchases")
}

