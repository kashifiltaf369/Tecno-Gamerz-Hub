// Friends System
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
  @@map("friendships")
}

// Chat Messages for real-time messaging
model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([isRead])
  @@map("chat_messages")
}

// Notifications System
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?            // Additional data like friendshipId, messageId, etc.
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// YouTube Channel Integration
model Channel {
  id         String   @id @default(uuid())
  name       String
  source     String   @default("youtube") // "youtube", "twitch", etc.
  externalId String   @unique             // YouTube channel ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  videos Video[]

  @@index([source])
  @@index([externalId])
  @@map("channels")
}

// Video Content from YouTube/Twitch
model Video {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(255)
  description String?   @db.Text
  youtubeId   String    @unique
  duration    Int?      // Duration in seconds
  publishedAt DateTime?
  thumbnails  Json?     // YouTube thumbnail URLs as JSON
  tags        String[]  @default([])
  transcript  String?   @db.Text
  views       Int       @default(0) // Our platform views, not YouTube views
  channelId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  channel             Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  videoInteractions   VideoInteraction[]
  videoQuizzes        VideoQuiz[]
  videoClips          VideoClip[]

  @@index([youtubeId])
  @@index([channelId])
  @@index([publishedAt])
  @@index([views])
  @@index([tags])
  @@map("videos")
}

// User interactions with videos
model VideoInteraction {
  id        String                @id @default(uuid())
  userId    String
  videoId   String
  action    VideoInteractionType
  progress  Int?                  @default(0) // Progress percentage for WATCH action
  metadata  Json?                 // Additional data like clip timestamps
  createdAt DateTime              @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId, action])
  @@index([userId])
  @@index([videoId])
  @@index([action])
  @@index([createdAt])
  @@map("video_interactions")
}

// Video Quizzes for gamification
model VideoQuiz {
  id          String   @id @default(uuid())
  videoId     String
  title       String
  description String?
  questions   Json     // Array of quiz questions with options and correct answers
  xpReward    Int      @default(50)
  coinsReward Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  video         Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  quizAttempts  VideoQuizAttempt[]

  @@index([videoId])
  @@map("video_quizzes")
}

// User quiz attempts
model VideoQuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  quizId    String
  score     Int      // Percentage score
  answers   Json     // User's answers
  xpEarned  Int      @default(0)
  coinsEarned Int    @default(0)
  completedAt DateTime @default(now())

  // Relations
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz VideoQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([userId])
  @@index([quizId])
  @@map("video_quiz_attempts")
}

// Video clips/highlights created by users
model VideoClip {
  id          String   @id @default(uuid())
  userId      String
  videoId     String
  title       String
  description String?
  startTime   Int      // Start time in seconds
  endTime     Int      // End time in seconds
  isPublic    Boolean  @default(true)
  views       Int      @default(0)
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  clipLikes VideoClipLike[]

  @@index([userId])
  @@index([videoId])
  @@index([isPublic])
  @@index([createdAt])
  @@map("video_clips")
}

// Video clip likes
model VideoClipLike {
  id     String @id @default(uuid())
  userId String
  clipId String
  createdAt DateTime @default(now())

  // Relations
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip VideoClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([userId, clipId])
  @@index([userId])
  @@index([clipId])
  @@map("video_clip_likes")
}

// Additional enums for tournament features
enum TournamentStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("tournament_status")
}

// Social features enums
enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("friendship_status")
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  TOURNAMENT_START
  TOURNAMENT_WIN
  MESSAGE_RECEIVED
  LEVEL_UP
  BADGE_EARNED
  VIDEO_WATCH_COMPLETE
  VIDEO_QUIZ_COMPLETE

  @@map("notification_type")
}

// Video interaction types
enum VideoInteractionType {
  WATCH
  LIKE
  COMMENT
  CLIP
  COMPLETE
  QUIZ_ATTEMPT

  @@map("video_interaction_type")
}

// Payment System Models

// Payment model for tracking all payment transactions
model Payment {
  id                String        @id @default(uuid())
  userId            String
  amount            Decimal       @db.Money
  currency          String        @default("USD") @db.VarChar(3)
  type              PaymentType
  status            PaymentStatus @default(PENDING)
  externalPaymentId String?       // Stripe payment intent/charge ID
  metadata          Json?         // Additional payment data (tournament id, product info, etc.)
  stripeCheckoutSessionId String? // Stripe checkout session ID
  refundedAmount    Decimal?      @db.Money
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([externalPaymentId])
  @@index([createdAt])
  @@map("payments")
}

// Subscription model for managing user subscriptions
model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  status               SubscriptionStatus
  plan                 SubscriptionPlan
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  startedAt            DateTime           @default(now())
  endedAt              DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

// Payment enums
enum PaymentType {
  TOURNAMENT_FEE
  PURCHASE
  SUBSCRIPTION
  AD
  SHOP_PURCHASE    // New: merchant store purchases

  @@map("payment_type")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED

  @@map("payment_status")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  UNPAID

  @@map("subscription_status")
}

enum SubscriptionPlan {
  BASIC
  PRO
  PREMIUM

  @@map("subscription_plan")
}

// Merchant Store Enums
enum ProductType {
  COSMETIC      // Skins, themes, etc.
  BADGE         // Achievement badges
  DISCOUNT      // Discount coupons
  PHYSICAL      // Physical merchandise

  @@map("product_type")
}

enum OrderStatus {
  PENDING       // Order created, payment pending
  PAID          // Payment successful
  FULFILLED     // Digital items granted / physical items shipped
  CANCELLED     // Order cancelled
  REFUNDED      // Order refunded

  @@map("order_status")
}

