#!/bin/bash

# Database seeding script for Tecno Gamerz Hub

set -e

echo "🌱 Seeding Tecno Gamerz Hub database..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Go to project root
cd "$(dirname "$0")/.."

# Check if .env file exists
if [ ! -f .env ]; then
    echo -e "${YELLOW}⚠️  No .env file found. Using .env.example as template...${NC}"
    cp .env.example .env
    echo -e "${YELLOW}⚠️  Please update .env with your actual configuration${NC}"
fi

# Load environment variables
if [ -f .env ]; then
    set -a
    source .env
    set +a
fi

echo -e "${BLUE}📋 Database seeding options:${NC}"
echo -e "  1. Fresh seed (reset and seed)"
echo -e "  2. Incremental seed (seed only)"
echo -e "  3. Reset database (migrations + seed)"
echo ""
read -p "Choose option (1-3): " option

case $option in
    1)
        echo -e "${BLUE}🔄 Resetting database and seeding...${NC}"
        pnpm db:push --force-reset
        pnpm db:seed
        ;;
    2)
        echo -e "${BLUE}🌱 Running incremental seed...${NC}"
        pnpm db:seed
        ;;
    3)
        echo -e "${BLUE}🗄️  Resetting database with migrations...${NC}"
        pnpm db:migrate reset --force
        pnpm db:seed
        ;;
    *)
        echo -e "${RED}❌ Invalid option${NC}"
        exit 1
        ;;
esac

echo -e "${GREEN}✅ Database seeding completed!${NC}"

if [ -n "$ADMIN_EMAIL" ]; then
    echo -e "${BLUE}👤 Admin user: ${YELLOW}$ADMIN_EMAIL${NC}"
else
    echo -e "${YELLOW}⚠️  No admin user created. Set ADMIN_EMAIL environment variable to create an admin user.${NC}"
fi