# Application
NODE_ENV=development
TURBO_TOKEN=optional_turbo_remote_cache_token
TURBO_TEAM=optional_turbo_team_name

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/tecno_gamerz_hub

# Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration (generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Next.js (Web App)
NEXTAUTH_SECRET=your-secret-here-32-chars-min
NEXTAUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# OAuth Providers
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_TWITCH_CLIENT_ID=your-twitch-client-id
OAUTH_TWITCH_CLIENT_SECRET=your-twitch-client-secret
OAUTH_YOUTUBE_CLIENT_ID=your-youtube-client-id
OAUTH_YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# Storage (S3-compatible)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=tecno-gamerz-hub
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_ENDPOINT=optional-custom-endpoint
STORAGE_PUBLIC_URL=optional-public-url
STORAGE_CDN_URL=optional-cdn-url

# YouTube API Configuration
YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_CHANNEL_ID=UCnuGhurhojQ8w6ksRZGcGOg

# Feature Flags
OAUTH_GOOGLE_ENABLED=true
OAUTH_TWITCH_ENABLED=true
OAUTH_YOUTUBE_ENABLED=true
QUEUE_PROCESSING_ENABLED=true
FILE_UPLOADS_ENABLED=true
AUDIT_LOGGING_ENABLED=true
VIDEO_SYNC_ENABLED=true

# Admin Setup
ADMIN_EMAIL=admin@example.com

# Logging
LOG_LEVEL=debug

# JWT Configuration (generate with: pnpm keys:generate)
JWT_ACCESS_SECRET="your-jwt-access-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# JWT Key Pairs (optional, for advanced JWT usage)
# JWT_ACCESS_PRIVATE_KEY="your-rsa-private-key-here"
# JWT_ACCESS_PUBLIC_KEY="your-rsa-public-key-here"
# JWT_REFRESH_PRIVATE_KEY="your-rsa-private-key-here"
# JWT_REFRESH_PUBLIC_KEY="your-rsa-public-key-here"
