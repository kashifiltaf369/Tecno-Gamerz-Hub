# Next.js Web Application Environment Variables

# Application
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# NextAuth.js
NEXTAUTH_SECRET=your-secret-here-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

OAUTH_TWITCH_CLIENT_ID=your-twitch-client-id
OAUTH_TWITCH_CLIENT_SECRET=your-twitch-client-secret

OAUTH_YOUTUBE_CLIENT_ID=your-youtube-client-id
OAUTH_YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# Feature Flags
OAUTH_GOOGLE_ENABLED=true
OAUTH_TWITCH_ENABLED=true
OAUTH_YOUTUBE_ENABLED=true

# Analytics (optional)
NEXT_PUBLIC_GA_ID=optional-google-analytics-id
NEXT_PUBLIC_SENTRY_DSN=optional-sentry-dsn