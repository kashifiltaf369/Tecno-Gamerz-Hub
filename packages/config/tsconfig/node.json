{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "declaration": true,
    "removeComments": true,
    "jsx": "react-jsx"
  },
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts", "**/*test.ts"]
}